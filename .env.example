# Supabase project used by the existing app (required for sign-in and data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Site origin used for the Google OAuth callback.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side credentials for AI and document/image uploads.
ANTHROPIC_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
